{
  "manifest_version": 3,
  "name": "ThunderClaude",
  "short_name": "TClaude",
  "description": "Rewrite Thunderbird compose drafts with LLM providers while preserving inline media.",
  "version": "0.0.0",
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": ["authenticationInfo", "personalCommunications"]
      },
      "id": "{4e8df8a7-6f5b-4f2b-8d8a-0d1b7178f01a}",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": ["compose", "scripting", "storage"],
  "host_permissions": [
    "http://localhost:11434/*",
    "https://api.anthropic.com/*",
    "https://api.deepseek.com/*",
    "https://api.minimax.io/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*"
  ],
  "background": {
    "scripts": ["src/background/index.js"],
    "type": "module"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "compose_action": {
    "default_title": "ThunderClaude",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_popup": "src/popup/popup.html"
  }
}
