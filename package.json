{
  "name": "thunderclaude",
  "version": "0.1.0",
  "private": true,
  "description": "Thunderbird MailExtension for rewriting compose-window email with LLM providers.",
  "type": "module",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . && prettier --check \"**/*.{js,mjs,json,css,html}\"",
    "format": "prettier --write .",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.4",
    "prettier": "^3.5.3",
    "vitest": "^3.0.8",
    "web-ext": "^10.1.0"
  }
}
